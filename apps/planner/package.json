{
  "name": "kontur-community-planner",
  "version": "0.1.0",
  "description": "Open-source project workspace from Kontur Community Edition",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173",
    "build": "vinext build && node scripts/finalize-build.mjs",
    "start": "vinext start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-rsc": "^0.5.34",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0-beta.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.124.0"
  }
}
