[Unit]
Description=Kontur Community Edition local planner
Documentation=https://github.com/imarochkin89-dot/LegoK
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kontur
Group=kontur
WorkingDirectory=/opt/kontur/app
ExecStart=/opt/kontur/app/distribution/linux-x64/node/bin/node /opt/kontur/app/distribution/linux-x64/runtime/server.mjs --config /etc/kontur/kontur.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=150s
TimeoutStopSec=30s
KillMode=mixed
RuntimeDirectory=kontur
RuntimeDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/kontur /var/log/kontur /run/kontur
Environment=HOME=/var/lib/kontur
Environment=XDG_CONFIG_HOME=/var/lib/kontur/.config
Environment=WRANGLER_SEND_METRICS=false

[Install]
WantedBy=multi-user.target
